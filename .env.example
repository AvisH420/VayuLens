# Copy to .env and fill in as needed. Only required if you set an LLM/embedding
# provider that calls an external API. The defaults run fully offline.

# LLM providers (set the one matching config llm.provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Config overrides (any config.yaml key via VAYULENS__SECTION__KEY)
# VAYULENS__LLM__PROVIDER=claude
# VAYULENS__EMBEDDINGS__PROVIDER=sentence_transformers
# VAYULENS__VECTOR_STORE__BACKEND=faiss
# VAYULENS__RERANKER__PROVIDER=cross_encoder
# VAYULENS__GROUNDING__CONFIDENCE_THRESHOLD=0.45
